# Hyperliquid API 配置
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# 公开收益排行榜接口（通常无需修改）
HYPERLIQUID_LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
# 跟随钱包的账户模式：standard 或 unified。目标地址无需设置模式。
HYPERLIQUID_ACCOUNT_MODE=standard

# 要跟随的目标地址（可填写普通钱包或 Vault 地址）
# 钱包示例：0x0ba5de43fa2419a25c2e680f84aff3a8f57fce22
# Vault 示例：0xd6e56265890b76413d1d527eb9b75e334c0c5b42
TARGET_WALLET_ADDRESS=

# 交易模式：首次使用请保持 true。实盘时必须改为 false。
SIMULATED_TRADING=true
SIMULATED_ACCOUNT_BALANCE=10000.0

# 跟单设置。建议首次实盘保持两个启动复制选项为 false。
# 已有仓位一律手动处理：启动不会自动追入，用 Telegram /copyloss 选仓位下单。
# 此项仅为兼容保留，置 true 也不会下单，只会在启动日志里提示。
COPY_OPEN_POSITIONS=false
COPY_EXISTING_ORDERS=false
# /copyloss 不带参数时列出的范围：
#   loss   只列目标当前浮亏的仓位（你会在比目标更好的价位进场）
#   profit 只列目标当前浮盈的仓位（等于追高，慎用）
#   all    全部持仓
COPY_OPEN_PNL_FILTER=loss
# 同一币种同方向在手动复制后多少分钟内不再重复买（0 = 关闭）。/copyloss ... force 可单次绕过。
COPY_DUPLICATE_GUARD_MINUTES=30
# 目标挂单出现时立即镜像；MIRROR_ORDER_PRICE 为 true 时用目标限价，false 时用当前中间价。
COPY_PENDING_ORDERS=true
CANCEL_MIRRORED_ORDERS=true
MIRROR_ORDER_PRICE=true
AUTO_ADJUST_SIZE=true
USE_LIMIT_ORDERS=false  # false：带滑点保护的 IOC 市价单；true：限价单
MAX_SLIPPAGE_PCT=1.0    # IOC 市价单允许的价格偏离百分比
# 每笔开仓最多使用可用保证金的比例；HIP-3 标的建议保守设置。
MAX_MARGIN_USAGE_RATIO=0.40
# 默认关闭 REST 成交补漏；开启后用于 WebSocket 断线期间补查成交。
FILL_POLLING_ENABLED=false
FILL_POLL_INTERVAL_SECONDS=15
# 未知币种的负缓存时长（秒，最小 30）。已知标的始终走内存，不会按此间隔重复拉取资产表。
ASSET_METADATA_TTL_SECONDS=300
# 同币种、同方向的密集目标挂单会在此静默窗口内合并为一笔镜像挂单。
PENDING_ORDER_MERGE_WINDOW_SECONDS=5
LEVERAGE_ADJUSTMENT=0.5 # 0.5：使用目标杠杆的一半；1.0：完全跟随目标杠杆
MAX_POSITION_SIZE=x    # x 表示不限制（默认）：只受交易所可用保证金约束；填数字则限制单仓名义价值（美元）
MAX_TOTAL_EXPOSURE=x   # 全部仓位合计名义价值上限；x 表示不限制（默认）
MAX_OPEN_TRADES=x       # 同时跟随的仓位数；x 表示不限制（默认），填 1 只跟第一个仓位
MAX_OPEN_ORDERS=x
MAX_ACCOUNT_EQUITY=x    # x 表示不限制；也可填写金额作为账户权益上限

# 币种过滤：英文逗号分隔，例如 BTC,ETH,SOL
BLOCKED_ASSETS=

# Telegram 机器人（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 未使用 Telegram 时可设为 false，以减少镜像依赖。
INSTALL_TELEGRAM=true

# 数据库
DATABASE_URL=sqlite:///./data/trading.db

# 日志
LOG_LEVEL=INFO
LOG_FILE=./logs/trading.log
